@page "/recherche"
@using LineVisApp.Models
@using LineVisApp.Services
@inject ILineVisService LineVisService

<PageTitle>LINE_VIS - Recherche</PageTitle>

<h3>Predecesseurs et successeurs d'un noeud</h3>

<form class="card mb-3" @onsubmit="RechercherAsync">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label" for="dta1">DTA_1</label>
                <input id="dta1" class="form-control" @bind="_dta1" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="dta2">DTA_2</label>
                <input id="dta2" class="form-control" @bind="_dta2" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="dta3">DTA_3</label>
                <input id="dta3" class="form-control" @bind="_dta3" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="dta4">DTA_4</label>
                <input id="dta4" class="form-control" @bind="_dta4" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="pgm">EXE_PGM_NME <small class="text-muted">(vide = tous)</small></label>
                <input id="pgm" class="form-control" list="programmes" @bind="_exePgmNme" />
                <datalist id="programmes">
                    @foreach (var pgm in _programmes)
                    {
                        <option value="@pgm"></option>
                    }
                </datalist>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100" disabled="@_loading">Rechercher</button>
            </div>
        </div>
        @if (_erreur != null)
        {
            <div class="text-danger mt-2">@_erreur</div>
        }
    </div>
</form>

@if (_loading)
{
    <p><em>Chargement...</em></p>
}
else if (_recherche != null)
{
    <p class="text-muted">
        Noeud <strong>@_recherche</strong>
    </p>

    @TableauLiens("Predecesseurs", "bg-warning text-dark", _predecesseurs)
    @TableauLiens("Successeurs", "bg-success text-white", _successeurs)
}

@code {
    private string? _dta1, _dta2, _dta3, _dta4, _exePgmNme;
    private IEnumerable<string> _programmes = Enumerable.Empty<string>();
    private List<LineVisLien> _predecesseurs = new();
    private List<LineVisLien> _successeurs = new();
    private string? _recherche;
    private string? _erreur;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _programmes = await LineVisService.GetProgrammesAsync();
    }

    private async Task RechercherAsync()
    {
        if (string.IsNullOrWhiteSpace(_dta1) || string.IsNullOrWhiteSpace(_dta2) ||
            string.IsNullOrWhiteSpace(_dta3) || string.IsNullOrWhiteSpace(_dta4))
        {
            _erreur = "Les 4 champs DTA_1 a DTA_4 sont obligatoires.";
            return;
        }

        _erreur = null;
        _loading = true;

        try
        {
            var liens = (await LineVisService.GetLiensNoeudProgrammeAsync(
                _dta1.Trim(), _dta2.Trim(), _dta3.Trim(), _dta4.Trim(), _exePgmNme)).ToList();

            _predecesseurs = liens.Where(l => l.EDG_DIR == "I").ToList();
            _successeurs = liens.Where(l => l.EDG_DIR == "O").ToList();
            _recherche = $"{_dta1.Trim()} / {_dta2.Trim()} / {_dta3.Trim()} / {_dta4.Trim()}"
                + (string.IsNullOrWhiteSpace(_exePgmNme) ? " - tous programmes" : $" - programme {_exePgmNme.Trim()}");
        }
        finally
        {
            _loading = false;
        }
    }

    // Clic sur un lien : on recherche ce noeud (tous programmes, son programme etant en general different)
    private async Task RechercherNoeudAsync(LineVisLien lien)
    {
        _dta1 = lien.EDG_1;
        _dta2 = lien.EDG_2;
        _dta3 = lien.EDG_3;
        _dta4 = lien.EDG_4;
        _exePgmNme = null;
        await RechercherAsync();
    }

    private RenderFragment TableauLiens(string titre, string classeEntete, List<LineVisLien> liens) => @<div class="card mb-3">
        <div class="card-header @classeEntete">
            <h5 class="mb-0">@titre (@liens.Count)</h5>
        </div>
        <div class="card-body p-0">
            @if (liens.Count == 0)
            {
                <p class="p-3 mb-0">Aucun lien</p>
            }
            else
            {
                <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>EDG_1</th>
                                <th>EDG_2</th>
                                <th>EDG_3</th>
                                <th>EDG_4</th>
                                @HeaColumns.Headers
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lien in liens)
                            {
                                <tr @onclick="() => RechercherNoeudAsync(lien)" style="cursor: pointer;" title="Rechercher ce noeud">
                                    <td>@lien.EDG_1</td>
                                    <td>@lien.EDG_2</td>
                                    <td>@lien.EDG_3</td>
                                    <td>@lien.EDG_4</td>
                                    @HeaColumns.Cells(lien)
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>;
}
